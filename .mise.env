# Project defaults for host UX (loaded by mise.toml and bin/lib.sh).
# Shell exports win. Do not put secrets here.
#
# Aligns with prebuilt ubuntu-mise:dev client major and cluster compose db:
#   POSTGRESQL_VERSION=17 task shell

POSTGRESQL_VERSION=18
IMAGE=ubuntu-mise:dev
CACHE_VOLUME=ubuntu-mise-cache
IMAGE_USER=dev
