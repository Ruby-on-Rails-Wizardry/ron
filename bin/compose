#!/usr/bin/env bash
# docker compose wrapper: writes .env then runs compose (development by default).
#
#   bin/compose up
#   bin/compose run --rm ubuntu-sample bash -l
#   COMPOSE_FILE=compose.prod.yml bin/compose up --build
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

COMPOSE_FILE="${COMPOSE_FILE:-${ROOT}/compose.yml}"
ENV_FILE="${COMPOSE_ENV_FILE:-${ROOT}/.env}"
COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-${SAMPLE}}"

require_docker
command -v docker >/dev/null 2>&1 || die "docker not found"
docker compose version >/dev/null 2>&1 || die "docker compose plugin not available"

if [[ ! -f "${COMPOSE_FILE}" ]]; then
  die "missing ${COMPOSE_FILE}"
fi

if [[ ! -d "${PROJECT}" ]]; then
  die "PROJECT is not a directory: ${PROJECT}"
fi
PROJECT_MOUNT="$(cd "${PROJECT}" && pwd)"

write_compose_env() {
  local tz
  tz="$(host_timezone)"
  cat >"${ENV_FILE}" <<EOF
# Generated by bin/compose — do not commit (see .gitignore / compose.env.example)
IMAGE=${IMAGE}
PROD_IMAGE=${PROD_IMAGE}
IMAGE_USER=${IMAGE_USER}
DEV_UID=${DEV_UID}
DEV_GID=${DEV_GID}
CACHE_VOLUME=${CACHE_VOLUME}
CACHE_ROOT=${CACHE_ROOT}
TZ=${tz}
POSTGRESQL_VERSION=${POSTGRESQL_VERSION:-}
PROJECT_MOUNT=${PROJECT_MOUNT}
HOSTNAME=${SAMPLE}
COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME}
EOF
  log "wrote ${ENV_FILE} (PROJECT_MOUNT=${PROJECT_MOUNT} IMAGE=${IMAGE} POSTGRESQL_VERSION=${POSTGRESQL_VERSION:-})"
}

write_compose_env
ensure_cache_volume

# shellcheck disable=SC2086
exec docker compose \
  --project-directory "${ROOT}" \
  --env-file "${ENV_FILE}" \
  -f "${COMPOSE_FILE}" \
  ${COMPOSE_OPTS:-} \
  "$@"
